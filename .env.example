# Local defaults: approved phrases only, in-memory database, admin disabled.
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional separate website origins; public /api/chat only, never admin APIs.
# For GitHub Pages: https://mikedunlap1.github.io (also add to ALLOWED_ORIGINS).
CHAT_WIDGET_ORIGINS=
AI_ENABLED=false
# Enable AI routing only after adding your server-side credentials.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_TIMEOUT_MS=7000
# Production requires an absolute persistent path, e.g. /var/data/chat/events.sqlite
CHAT_DB_PATH=:memory:
# Generate four DIFFERENT values with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOG_ENCRYPTION_KEY=
IP_HASH_KEY=
SESSION_SIGNING_KEY=
ADMIN_TOKEN=
LOG_RETENTION_DAYS=14
MAX_LOG_EVENTS=50000
IP_REQUESTS_PER_MINUTE=20
SESSION_REQUESTS_PER_MINUTE=10
DAILY_CHAT_LIMIT=1000
# Exact IPs of trusted direct reverse proxies only. No CIDR/wildcards.
# If blank, proxy headers are ignored and visitors behind a proxy share its IP limit.
TRUSTED_PROXY_IPS=
